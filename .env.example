DATABASE_URI=                         # MongoDB connection URI for the vnp-scraper database
EXPEDIA_EMAIL=                        # Expedia account email used for scraping or login
EXPEDIA_PASSWORD=                     # Expedia account password
PORT=                                 # Port on which the Node.js server will run
TOKEN_PATH=                           # Local path to the saved Google OAuth token JSON file
CLIENT_ID=                            # Google OAuth client ID for API authentication
CLIENT_SECRET=                        # Google OAuth client secret for API authentication
FRONTEND_REDIRECT_URI=               # URL to redirect the user after Google OAuth completes
CHUNK_SIZE=                           # Size of data chunks to process at a time
BRIGHT_DATA_USERNAME=                # Username for BrightData (formerly Luminati) proxy access
BRIGHT_DATA_PASSWORD=                # Password for BrightData proxy access
STEEL_API_KEY=                        # API key for accessing Steel API (used for scraping or proxy control)
LOCATION_COUNTRY_CODE=               # Default country code used in scraping operations (e.g., 'US')
ENCRYPTION_KEY=                      # Encryption key used for securing sensitive data (must be 32 characters for AES-256)
BROWSERLESS_TOKEN=                   # API token for using Browserless.io (headless browser-as-a-service)
AWS_ACCESS_KEY_ID=                   # AWS access key ID for accessing S3
AWS_SECRET_ACCESS_KEY=               # AWS secret access key for accessing S3
AWS_REGION=                          # AWS region where the S3 bucket is hosted
AWS_S3_BUCKET=                       # Name of the AWS S3 bucket where files are uploaded
S3_BUCKET_URL=                       # Public base URL to access files from the S3 bucket
REDIRECT_URI=                        # Backend redirect URI for Google OAuth callback
OUR_CONTACT=                         # Single contact phone (for OTP). Used if OUR_CONTACTS is not set.
# OUR_CONTACTS: one entry per line. Format: phone:slot (slot = port number, used to match OTP email).
# - phone = your number for that line (used on the site for OTP).
# - slot  = port number: from email Subject "PORT 9 SMS" → use 9, or from body Receiver "9.01" → first number (9).
# Matching uses SLOT only (Sender is not used). Example: 571-245-6664:9 matches emails where slot is 9.
# Entries: 571-245-6664:9,18765551234:2 (comma-separated). One picked at random per job.
OUR_CONTACTS=
BROWSER_TIME_LIMIT=                  # Time limit for browser-based scraping jobs (e.g., '15m' for 15 minutes, 6h for 6 hours)
NODE_ENV=                            # Node.js environment mode: production, local
ENVIRONMENT=                         # Current scraper environment type, e.g., 'browserless', 'local'
MAX_WORKER_THREADS=                  # Maximum number of worker threads to run concurrently
WORKER_QUEUE_SIZE=                   # Maximum number of jobs allowed in the worker queue

# Email Configuration for CAPTCHA alerts
SMTP_HOST=                           # SMTP server host (e.g., 'mailhog' for development, 'smtp.gmail.com' for production)
SMTP_PORT=                           # SMTP server port (e.g., 1025 for MailHog, 587 for Gmail)
EMAIL_USER=                          # SMTP authentication username
EMAIL_PASSWORD=                      # SMTP authentication password
EMAIL_FROM=                          # From address for outgoing emails
CAPTCHA_NOTIFICATION_EMAIL=          # Primary email for CAPTCHA notifications (fallback)
CAPTCHA_RECIPIENTS=                  # Comma-separated list of emails to receive CAPTCHA alerts (e.g., 'admin@company.com,dev@company.com')